      "dialogue": [
        { "role": "staff", "en": "Hi. Where to?", "zh": "你好，要去哪裡？", "alts": ["Where would you like to go?"] },
        { "role": "customer", "en": "To the City Hotel, please.", "zh": "請到城市飯店。", "alts": ["Please take me to the City Hotel.", "City Hotel, please."] },
        { "role": "staff", "en": "OK. Please fasten your seat belt.", "zh": "好的，請繫上安全帶。" },
