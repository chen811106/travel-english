  "situations": [
    {
      "id": "way",
      "title": "問怎麼走",
      "emoji": "🗺️",
      "desc": "問地點、聽懂左轉右轉",
      "dialogue": [
        { "role": "customer", "en": "Excuse me. Where is the train station?", "zh": "不好意思，請問火車站在哪裡？", "alts": ["How do I get to the train station?", "Can you tell me the way to the train station?"] },
        { "role": "staff", "en": "Go straight and turn left at the corner.", "zh": "直走，在轉角左轉。", "alts": ["Walk straight, then turn left at the corner."] },
        { "role": "customer", "en": "Is it far from here?", "zh": "離這裡遠嗎？", "alts": ["How far is it?"] },
        { "role": "staff", "en": "No, it's about five minutes on foot.", "zh": "不遠，走路大約五分鐘。", "alts": ["It's a five-minute walk."] },
        { "role": "customer", "en": "Can you show me on the map?", "zh": "可以在地圖上指給我看嗎？", "alts": ["Could you show me on my phone?"] },
        { "role": "staff", "en": "Sure. We are here, and the station is here.", "zh": "當然。我們在這裡，車站在這裡。" },
        { "role": "customer", "en": "Thank you so much!", "zh": "非常謝謝你！", "alts": ["Thanks for your help!"] }
      ],
      "patterns": [
        { "template": "Where is {}?", "zh": "{}在哪裡？", "alts": ["How do I get to {}?"], "tip": "問路最基本的一句。",
          "options": [ { "en": "the train station", "zh": "火車站" }, { "en": "the bus stop", "zh": "公車站" }, { "en": "the museum", "zh": "博物館" }, { "en": "the nearest restroom", "zh": "最近的廁所" } ] },
        { "template": "Is there {} near here?", "zh": "這附近有{}嗎？", "alts": ["Where can I find {}?"], "tip": "找附近有沒有某種店。",
          "options": [ { "en": "a convenience store", "zh": "便利商店" }, { "en": "an ATM", "zh": "提款機" }, { "en": "a pharmacy", "zh": "藥局" }, { "en": "a subway station", "zh": "地鐵站" } ] },
        { "template": "Do I turn {}?", "zh": "我要{}嗎？", "alts": ["Should I turn {}?"], "tip": "確認方向有沒有聽對。",
          "options": [ { "en": "left", "zh": "左轉" }, { "en": "right", "zh": "右轉" }, { "en": "at the corner", "zh": "在轉角轉" }, { "en": "at the traffic light", "zh": "在紅綠燈轉" } ] }
      ],
      "questions": [
        { "en": "Go straight and turn right.", "alts": ["Walk straight, then turn right."],
          "choices": ["直走然後右轉", "直走然後左轉", "往回走然後右轉"], "answer": 0,
          "replies": [ { "en": "Go straight and turn right. Thanks!", "zh": "直走然後右轉，謝謝！" }, { "en": "Sorry, can you say that again?", "zh": "不好意思，可以再說一次嗎？", "alts": ["Could you speak more slowly?"] } ] },
        { "en": "It's next to the bank.", "alts": ["It's beside the bank."],
          "choices": ["在銀行旁邊", "在銀行對面", "在銀行裡面"], "answer": 0,
          "replies": [ { "en": "Next to the bank. Thank you!", "zh": "在銀行旁邊，謝謝！" }, { "en": "Where is the bank?", "zh": "銀行在哪裡？" } ] },
        { "en": "It's across the street.", "alts": ["It's on the other side of the street."],
          "choices": ["在對街", "在這條街的盡頭", "在轉角"], "answer": 0,
          "replies": [ { "en": "OK, thank you.", "zh": "好的，謝謝。" }, { "en": "Do I cross here?", "zh": "我要在這裡過馬路嗎？" } ] },
        { "en": "It's about ten minutes on foot.", "alts": ["It's a ten-minute walk."],
          "choices": ["走路大約十分鐘", "坐車大約十分鐘", "十分鐘後關門"], "answer": 0,
          "replies": [ { "en": "Great, thanks!", "zh": "太好了，謝謝！" }, { "en": "Can I take a bus?", "zh": "可以搭公車嗎？" } ] },
        { "en": "Where do you want to go?", "alts": ["Where are you going?"],
          "choices": ["你要去哪裡？", "你從哪裡來？", "你要買什麼？"], "answer": 0,
          "replies": [ { "en": "I want to go to the museum.", "zh": "我想去博物館。", "alts": ["I'm looking for the museum."] }, { "en": "I'm looking for this place.", "zh": "我在找這個地方。（給對方看手機）" } ] }
      ]
    },
    {
