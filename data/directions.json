      "roles": { "staff": { "name": "站務人員", "emoji": "🧑‍💼" } },
      "dialogue": [
        { "role": "customer", "en": "Excuse me. Which train goes to the airport?", "zh": "不好意思，哪一班車到機場？", "alts": ["How do I get to the airport by train?"] },
        { "role": "staff", "en": "Take the blue line.", "zh": "搭藍線。", "alts": ["You need the blue line."] },
        { "role": "customer", "en": "Where can I buy a ticket?", "zh": "我可以在哪裡買票？", "alts": ["Where is the ticket machine?"] },
        { "role": "staff", "en": "You can use the machine over there.", "zh": "你可以用那邊的機器。" },
        { "role": "customer", "en": "How many stops is it?", "zh": "要坐幾站？", "alts": ["How many stations?"] },
        { "role": "staff", "en": "Six stops.", "zh": "六站。", "alts": ["It's six stops from here."] },
        { "role": "customer", "en": "Do I need to change trains?", "zh": "我需要換車嗎？", "alts": ["Do I have to transfer?"] },
        { "role": "staff", "en": "No, it's a direct train.", "zh": "不用，是直達車。", "alts": ["No, you don't."] }
      ],
      "patterns": [
        { "template": "Which train goes to {}?", "zh": "哪一班車到{}？", "alts": ["Does this train go to {}?"], "tip": "不知道搭哪班車時問。",
          "options": [ { "en": "the airport", "zh": "機場" }, { "en": "the city center", "zh": "市中心" }, { "en": "Central Station", "zh": "中央車站" }, { "en": "the zoo", "zh": "動物園" } ] },
        { "template": "Where can I buy {}?", "zh": "我可以在哪裡買{}？", "alts": ["Where do I get {}?"], "tip": "找買票的地方。",
          "options": [ { "en": "a ticket", "zh": "車票" }, { "en": "a day pass", "zh": "一日券" }, { "en": "a transport card", "zh": "交通卡" } ] },
        { "template": "How much is {}?", "zh": "{}多少錢？", "alts": ["How much does {} cost?"], "tip": "問票價。",
          "options": [ { "en": "a ticket", "zh": "一張票" }, { "en": "a ticket to the airport", "zh": "到機場的票" }, { "en": "the day pass", "zh": "一日券" } ] }
      ],
      "questions": [
        { "en": "Take the blue line.", "alts": ["You need the blue line."],
          "choices": ["搭藍線", "搭紅線", "走藍色的門"], "answer": 0,
          "replies": [ { "en": "The blue line. Thank you!", "zh": "藍線，謝謝！" }, { "en": "Where is the blue line?", "zh": "藍線在哪裡？" } ] },
        { "en": "Change trains at Central Station.", "alts": ["Transfer at Central Station."],
          "choices": ["在中央車站換車", "在中央車站下車", "在中央車站買票"], "answer": 0,
          "replies": [ { "en": "OK, change at Central Station.", "zh": "好，在中央車站換車。" }, { "en": "How many stops is it?", "zh": "要坐幾站？" } ] },
        { "en": "Get off at the next stop.", "alts": ["Your stop is next."],
          "choices": ["下一站下車", "下一站上車", "下一站很遠"], "answer": 0,
          "replies": [ { "en": "Thank you!", "zh": "謝謝！" }, { "en": "Thanks for telling me.", "zh": "謝謝你告訴我。" } ] },
        { "en": "Please tap your card here.", "alts": ["Scan your card here, please."],
          "choices": ["請在這裡感應你的卡", "請在這裡買卡", "請把卡給我"], "answer": 0,
          "replies": [ { "en": "OK.", "zh": "好的。" }, { "en": "It doesn't work.", "zh": "不能用耶。", "alts": ["My card isn't working."] } ] }
      ]
    },
    {
