          "options": [ { "en": "the airport", "zh": "機場" }, { "en": "this address", "zh": "這個地址" }, { "en": "the City Hotel", "zh": "城市飯店" }, { "en": "the train station", "zh": "火車站" } ] },
        { "template": "Can you {}, please?", "zh": "可以請你{}嗎？", "alts": ["Could you {}?"], "tip": "請司機幫忙。",
          "options": [ { "en": "stop here", "zh": "在這裡停" }, { "en": "turn on the meter", "zh": "跳表" }, { "en": "open the trunk", "zh": "打開後車廂" }, { "en": "wait for me", "zh": "等我一下" } ] },
        { "template": "How much is it to {}?", "zh": "到{}要多少錢？", "alts": ["How much to {}?"], "tip": "上車前先問價錢。",
          "options": [ { "en": "the airport", "zh": "機場" }, { "en": "the hotel", "zh": "飯店" }, { "en": "downtown", "zh": "市區" } ] }
      ],
      "questions": [
        { "en": "Where to?", "alts": ["Where would you like to go?", "Where are you going?"],
          "choices": ["要去哪裡？", "從哪裡來？", "要坐哪裡？"], "answer": 0,
          "replies": [ { "en": "To the City Hotel, please.", "zh": "請到城市飯店。", "alts": ["City Hotel, please."] }, { "en": "To this address, please.", "zh": "請到這個地址。（給司機看）" } ] },
        { "en": "Please fasten your seat belt.", "alts": ["Seat belt, please."],
          "choices": ["請繫上安全帶", "請關上車門", "請把東西放後車廂"], "answer": 0,
          "replies": [ { "en": "OK.", "zh": "好的。" }, { "en": "Sure, sorry.", "zh": "好，抱歉。" } ] },
        { "en": "Is here OK?", "alts": ["Can I drop you here?"],
          "choices": ["停在這裡可以嗎？", "你要在這裡吃嗎？", "這裡很遠嗎？"], "answer": 0,
          "replies": [ { "en": "Yes, here is fine.", "zh": "可以，這裡就好。" }, { "en": "A little further, please.", "zh": "再往前一點，謝謝。" } ] },
        { "en": "Do you need a receipt?", "alts": ["Would you like a receipt?"],
          "choices": ["你需要收據嗎？", "你需要零錢嗎？", "你需要袋子嗎？"], "answer": 0,
          "replies": [ { "en": "Yes, please.", "zh": "要，謝謝。" }, { "en": "No, thank you.", "zh": "不用，謝謝。" } ] }
      ]
